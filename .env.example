# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave unset to use local SQLite.
# When you move to Supabase, set this to your Supabase Postgres connection string:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# DATABASE_URL=

# Site / owner info shown in the nav, footer, and home page
SITE_NAME=Sajan Bista
SITE_TAGLINE=Data Engineer
SITE_EMAIL=
GITHUB_USERNAME=
LINKEDIN_URL=

# GitHub integration for the Learning Log (issue creation per ticket)
# Create a fine-grained PAT with Issues read/write on the target repo.
GITHUB_TOKEN=
GITHUB_REPO=
