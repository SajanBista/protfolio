# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated. Only needed in production, e.g. https://yourapp.onrender.com
CSRF_TRUSTED_ORIGINS=

# Database — leave unset to use local SQLite.
# When you move to Supabase, set this to your Supabase Postgres connection string:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
# DATABASE_URL=

# Media storage — leave all blank to keep saving uploads to local disk
# (fine for local dev; most free hosts wipe local disk on every deploy).
# Fill these in to store uploads (avatar, resume, project/blog covers) in a
# Supabase Storage bucket instead. Create a PUBLIC bucket in your Supabase
# project's Storage tab, then get the access keys from
# Project Settings -> Data API -> Storage (or Project Settings -> API keys
# for an S3-compatible access key pair under Storage -> S3 Connection).
SUPABASE_PROJECT_REF=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=media
SUPABASE_S3_REGION=us-east-1

# Site / owner info shown in the nav, footer, and home page
SITE_NAME=Sajan Bista
SITE_TAGLINE=Data Engineer
SITE_EMAIL=
GITHUB_USERNAME=
LINKEDIN_URL=

# GitHub integration for the Learning Log (issue creation per ticket)
# Create a fine-grained PAT with Issues read/write on the target repo.
GITHUB_TOKEN=
GITHUB_REPO=
